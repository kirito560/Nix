# Copia este archivo como .env y rellena los valores. Nunca subas el .env a git.

# --- Seguridad (obligatorio; el MISMO valor en el servidor y en el cliente) ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
NIX_TOKEN=

# --- Servidor ---
# IP donde escucha el WebSocket: la de la red local del servidor (no uses 0.0.0.0).
NIX_HOST=192.168.1.50
NIX_PUERTO=8765
# Solo se aceptan conexiones desde estas redes (separadas por comas).
NIX_REDES_PERMITIDAS=127.0.0.0/8,192.168.1.0/24
# Personaje: nombre de un archivo de personajes/ sin .md (nix o narwell).
PERSONAJE=nix
# Datos de cada personaje (memoria, marcadores, retos): NIX_DATOS_DIR/<personaje>
NIX_DATOS_DIR=/datos/nix

# --- Voz a texto (STT) ---
# auto = Deepgram si hay clave, luego Groq, si no el simulado (stub). También: deepgram | groq | stub
STT_PROVEEDOR=groq
DEEPGRAM_API_KEY=
DEEPGRAM_MODELO=nova-3
DEEPGRAM_IDIOMA=es-419
GROQ_API_KEY=
GROQ_MODELO_STT=whisper-large-v3-turbo
IDIOMA=es
# Palabras que se dicen seguido, para que Whisper las escriba bien (prompt de contexto de Groq).
STT_PROMPT=Nix, Minecraft, PvP, Roblox, Visual Studio, VTube Studio.
# Confianza mínima de Whisper (avg_logprob, de -inf a 0). Por debajo, Nix pide que se lo repitan.
STT_MIN_LOGPROB=-1.0

# --- Cerebro: LLM (fase 2) ---
# auto = Groq si hay GROQ_API_KEY (la misma clave del STT); si no, el simulado. También: groq | stub
LLM_PROVEEDOR=auto
# El más rápido medido con buen español (ver ESTADO.md). Está en vista previa: Groq puede retirarlo.
LLM_MODELO=qwen/qwen3.8-27b
# Si Groq retira LLM_MODELO, se usa este (de producción). Vacío = sin respaldo.
LLM_MODELO_RESPALDO=openai/gpt-oss-120b
# Solo modelos gpt-oss: low = menos espera antes de la primera palabra
LLM_RAZONAMIENTO=low
LLM_MAX_TOKENS=300
LLM_TEMPERATURA=0.8
# Pares pregunta/respuesta que recuerda (en memoria; la memoria de verdad llega en la fase 4)
HISTORIAL_TURNOS=10

# --- Voz del personaje (TTS) ---
# auto = edge-tts (sin clave; necesita ffmpeg en el servidor); si no, el simulado. También: edge | stub
TTS_PROVEEDOR=auto
# Vacío = la voz de la ficha del personaje (es-MX-DaliaNeural para Nix)
TTS_VOZ=
TTS_VELOCIDAD=+0%
# Conexiones con edge-tts abiertas de antemano mientras hay alguien conectado (ahorra ~500 ms por frase).
# 0 = abrir una en cada frase.
TTS_CONEXIONES=1
# Se renuevan antes de pasar este tiempo sin usarse (medido: Microsoft las cierra entre 15 y 45 s)
TTS_OCIO_S=12

# --- Interrumpirla (barge-in) ---
BARGE_IN=1
# Mientras habla, tu frase solo la interrumpe si dura al menos esto; si no, se toma por eco de su voz.
BARGE_MIN_VOZ_MS=400

# --- Detector de voz (VAD) ---
SILERO_ONNX=/datos/modelos/silero_vad.onnx
VAD_UMBRAL=0.5
# Silencio que cierra una frase: cuanto menor, menos latencia pero más cortes a media frase.
VAD_SILENCIO_MS=400
VAD_MIN_VOZ_MS=250
# Tras este silencio se empieza a transcribir por adelantado (ahorra ~200 ms con Groq). 0 = no.
STT_ADELANTO_MS=200

# --- Visión: la pantalla del usuario (servidor) ---
# 0 = el servidor ignora todo lo que llegue de la pantalla. 1 = lo usa (la captura igual empieza apagada en el
# PC y solo se enciende con --pantalla on o Ctrl+Alt+P).
VISION_HABILITADA=0
# auto = Groq si hay GROQ_API_KEY (describe las imágenes que pidas con Ctrl+Alt+M); stub = «pantalla sin descripción».
VISION_PROVEEDOR=auto
VISION_MODELO=qwen/qwen3.8-27b
# Tope del resumen de pantalla que se añade al prompt del LLM (≈ 4 caracteres por token).
VISION_MAX_TOKENS=120

# --- Cliente (Windows) ---
NIX_SERVIDOR=ws://192.168.1.50:8765
# Índice o nombre del micrófono (python -m client.main --listar). Vacío = el predeterminado.
MIC_DISPOSITIVO=
# Índice o nombre de la salida de audio (python -m client.main --listar). Vacío = la predeterminada.
ALTAVOZ_DISPOSITIVO=
# Cancelación de eco (resta su voz de lo que capta el micrófono). Con audífonos se puede apagar (AEC=0).
AEC=1
# Vacío = la latencia que informa la tarjeta. Si el eco no baja (ver «eco atenuado» en pantalla), prueba 50-150.
AEC_RETRASO_MS=

# --- Cliente: captura de pantalla (APAGADA al arrancar; Ctrl+Alt+P la enciende o pausa al instante) ---
# Capturas por segundo (1 o 2). Nada se guarda en disco.
PANTALLA_FPS=1
# Cuánto debe cambiar la pantalla (bits distintos de su pHash, de 64) para avisar a Nix.
PANTALLA_UMBRAL=10
# 0 = solo se manda una descripción breve hecha en el PC (el título de la ventana activa).
# 1 = en cada cambio se manda además la imagen reducida (768 px) para que el servidor la describa.
# Con 0, Ctrl+Alt+M manda una sola imagen cuando tú lo pidas.
PANTALLA_ENVIAR_IMAGEN=0
# Ventanas que nunca se capturan: si el título de la ventana activa contiene alguna (sin distinguir
# mayúsculas), no se captura nada. Vacío = esta misma lista.
PANTALLA_EXCLUIR=contraseña,password,1password,bitwarden,keepass,lastpass,administrador de credenciales,credential manager,iniciar sesión,inicio de sesión,sign in,login,banco,bank,banca,bbva,santander,banorte,banamex,hsbc,scotiabank,mercado pago,paypal
