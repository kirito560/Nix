# Copia este archivo como .env y rellena los valores. Nunca subas el .env a git.

# --- Seguridad (obligatorio; el MISMO valor en el servidor y en el cliente) ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
NIX_TOKEN=

# --- Servidor ---
# IP donde escucha el WebSocket: la de la red local del servidor (no uses 0.0.0.0).
NIX_HOST=192.168.1.50
NIX_PUERTO=8765
# Solo se aceptan conexiones desde estas redes (separadas por comas).
NIX_REDES_PERMITIDAS=127.0.0.0/8,192.168.1.0/24
# Personaje: nombre de un archivo de personajes/ sin .md (nix o narwell).
PERSONAJE=nix
# Datos de cada personaje (memoria, marcadores, retos): NIX_DATOS_DIR/<personaje>
NIX_DATOS_DIR=/datos/nix

# --- Voz a texto (STT) ---
# auto = Deepgram si hay clave, luego Groq, si no el simulado (stub). También: deepgram | groq | stub
STT_PROVEEDOR=auto
DEEPGRAM_API_KEY=
DEEPGRAM_MODELO=nova-3
DEEPGRAM_IDIOMA=es-419
GROQ_API_KEY=
GROQ_MODELO_STT=whisper-large-v3-turbo
IDIOMA=es

# --- Detector de voz (VAD) ---
SILERO_ONNX=/datos/modelos/silero_vad.onnx
VAD_UMBRAL=0.5
# Silencio que cierra una frase: cuanto menor, menos latencia pero más cortes a media frase.
VAD_SILENCIO_MS=400
VAD_MIN_VOZ_MS=250

# --- Percepción (fase 5). Apagada: no se captura pantalla ni se envían imágenes a ninguna nube. ---
VISION_HABILITADA=0

# --- Cliente (Windows) ---
NIX_SERVIDOR=ws://192.168.1.50:8765
# Índice o nombre del micrófono (python -m client.main --listar). Vacío = el predeterminado.
MIC_DISPOSITIVO=
